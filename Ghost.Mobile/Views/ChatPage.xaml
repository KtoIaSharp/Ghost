<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Ghost.Mobile.Views"
             x:Class="Ghost.Mobile.Views.ChatPage"
             Title="{Binding ChatPartnerNick}"
             BackgroundColor="#0f0f23">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Статус сделки -->
        <Frame Grid.Row="0" Margin="10" Padding="15" BackgroundColor="#16213e" BorderColor="#1a1a3e" CornerRadius="10" HasShadow="False">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="StatusLabel" Grid.Column="0" TextColor="#fbbf24" FontSize="14"/>
                <Label x:Name="AmountLabel" Grid.Column="1" TextColor="#4ade80" FontSize="14" FontAttributes="Bold" HorizontalOptions="End"/>
            </Grid>
        </Frame>

        <!-- Сообщения -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesCollection"
                        SelectionMode="None"
                        BackgroundColor="#0f0f23">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="💬" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Сообщений пока нет" TextColor="#666680" FontSize="16" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Кнопки действий -->
        <HorizontalStackLayout Grid.Row="2" Padding="10,5" Spacing="10" HorizontalOptions="Center"
                               IsVisible="{Binding Deal.Status, Converter={conv:DealActionVisibilityConverter}}">
            <Button x:Name="ConfirmButton" Text="✅ Подтвердить" Command="{Binding ConfirmDealCommand}"
                    BackgroundColor="#4ade80" TextColor="#000000" FontSize="12" HeightRequest="40" CornerRadius="8"/>
            <Button x:Name="DisputeButton" Text="⚠️ Спор" Command="{Binding DisputeDealCommand}"
                    BackgroundColor="#ff6b6b" TextColor="#ffffff" FontSize="12" HeightRequest="40" CornerRadius="8"/>
        </HorizontalStackLayout>

        <!-- Ввод сообщения -->
        <Grid Grid.Row="3" Padding="10" ColumnDefinitions="*,Auto" BackgroundColor="#16213e"
              IsVisible="{Binding Deal.Status, Converter={conv:ChatInputVisibilityConverter}}">
            <Entry Grid.Column="0" x:Name="MessageEntry"
                   Text="{Binding MessageText}"
                   Placeholder="Сообщение..."
                   BackgroundColor="#1a1a2e"
                   TextColor="#ffffff"
                   PlaceholderColor="#666680"
                   HeightRequest="45"
                   ReturnCommand="{Binding SendMessageCommand}"/>
            <Button Grid.Column="1" Text="📤" Command="{Binding SendMessageCommand}"
                    BackgroundColor="#667eea" WidthRequest="50" HeightRequest="45" CornerRadius="8" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</ContentPage>
