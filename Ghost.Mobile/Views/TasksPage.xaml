<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ghost.Mobile.Views.TasksPage"
             Title="Задания"
             BackgroundColor="#0f0f23">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="15,10" BackgroundColor="#16213e">
            <Picker x:Name="CategoryPicker"
                    Title="Категория"
                    TextColor="#ffffff"
                    BackgroundColor="#1a1a2e"
                    HeightRequest="45"/>

            <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                <CheckBox x:Name="OnlyPaidCheckBox" Color="#667eea"/>
                <Label Text="Только платные" TextColor="#a0a0b0" VerticalOptions="Center" FontSize="14"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     x:Name="RefreshView"
                     RefreshColor="#667eea">
            <CollectionView x:Name="TasksCollection"
                            SelectionMode="None"
                            BackgroundColor="#0f0f23">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="📭" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="Заданий пока нет" TextColor="#666680" FontSize="18" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           Color="#667eea"
                           IsVisible="False"
                           IsRunning="False"
                           HeightRequest="50"/>
    </Grid>
</ContentPage>
